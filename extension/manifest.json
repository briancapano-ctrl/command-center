{
  "manifest_version": 3,
  "name": "Command Center Work Lane",
  "version": "2.0.0",
  "description": "Browser-local work agenda and Copilot briefing priorities for your Command Center. One-way, no personal data sent to work apps.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Command Center Work Lane",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office365.com/*",
        "https://m365.cloud.microsoft/chat*"
      ],
      "js": [
        "lane_flag.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "work_outlook.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://m365.cloud.microsoft/chat*"
      ],
      "js": [
        "work_copilot.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://briancapano-ctrl.github.io/command-center/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
